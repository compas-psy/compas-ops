# Без этого Git на Windows (core.autocrlf=true по умолчанию) молча
# конвертирует LF в CRLF при checkout — и любой shebang-скрипт после
# scp на Linux-сервер падает с "bash\r: No such file or directory".
# Явное объявление здесь работает независимо от локальных настроек
# git у того, кто клонирует репозиторий.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.ini text eol=lf
*.toml text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf

*.png binary
*.thumbnail binary
