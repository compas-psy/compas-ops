# HELM Knowledge worker (P8.5.2) — отдельный образ и контейнер от Control
# Plane API. Причина: `helm_core/knowledge/parsers.py` docstring — Docling
# тянет ~5.7GB (torch, OCR-модели) и при разборе скана/сложного PDF может
# дать заметный скачок RAM; тяжёлый разбор не должен делить процесс с
# живыми вебхуками MAX/Telegram (лимит helm-core — 768MB).
#
# Проверено эмпирически в песочнице разработки (не гипотеза): worker.py/
# worker_main.py/ingest.py/parsers.py реально импортируются без fastapi,
# uvicorn, alembic, webauthn, pyyaml — эти пакеты воркеру не нужны вовсе,
# он не FastAPI-приложение.
FROM python:3.12.8-slim-bookworm AS base

RUN useradd --system --create-home --uid 10002 helm-worker

# opencv-python (транзитивная зависимость Docling/RapidOCR) на Debian
# slim требует эти системные библиотеки — без них падает на первом же
# `import cv2`, а не молча. ffmpeg — явное требование спеки (§14.7),
# используется пайплайном GigaAM (P8.5.3) для конвертации аудио. git —
# для `pip install gigaam @ git+...` ниже: base-образ python:slim его не
# несёт вовсе, pip падает на `git clone` без него (найдено живым запуском
# 31.08.2026, "Cannot find command 'git'").
RUN apt-get update && apt-get install --no-install-recommends -y \
      ffmpeg git libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/helm/knowledge-worker

# CPU-only torch ЯВНО через официальный индекс PyTorch — без этой строки
# `pip install docling` сам подтягивает обычный torch и берёт CUDA-сборку
# (~1.2GB лишних nvidia_*-пакетов на сервере без GPU — проверено
# эмпирически в песочнице разработки установкой без этого флага).
#
# torchvision/torchaudio — ОБЯЗАТЕЛЬНО той же командой, с того же индекса:
# НАЙДЕНО живым тестом на сервере — установка одного torch здесь и
# torchvision отдельно (как транзитивная зависимость docling с обычного
# PyPI) дала несовместимую пару сборок (разные ABI) и уронила Docling с
# `RuntimeError: operator torchvision::nms does not exist` при первой
# же попытке импортировать transformers.AutoImageProcessor — классическая
# ошибка рассинхрона torch/torchvision, а не проблема самого файла или
# кода. torch и torchvision обязаны приходить из ОДНОЙ команды install
# с ОДНОГО индекса, чтобы pip подобрал совместимую пару версий. torchaudio
# добавлен той же командой заранее (нужен GigaAM, ставится ниже) — по
# той же причине: если оставить его транзитивной зависимостью gigaam[torch]
# с обычного PyPI, есть риск того же класса ABI-рассинхрона.
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# MarkItDown — только нужные extras (§14.6: "only required extras"), не
# [all] (тянет Azure cloud SDK и youtube/audio-transcription — облачные
# и ненужные, извлечение аудио делает GigaAM, не MarkItDown).
RUN pip install --no-cache-dir "markitdown[docx,pptx,xlsx,xls,pdf,outlook]==0.1.7"
RUN pip install --no-cache-dir docling

# GigaAM (§14.7, P8.5.3) — git install, не PyPI: пакет на PyPI (0.1.0,
# апрель 2025) не несёт актуальное семейство v3 моделей, которое есть на
# main ветке репозитория (проверено живьём — карточки моделей и код
# main расходятся с релизом на PyPI). Запинено на конкретный commit
# (§33 "pin versions"), не на плавающий main.
#
# БЕЗ extras [longform]: официальный transcribe_longform() тянет
# pyannote.audio==4.0.* для VAD, а её дефолтная сегментационная модель
# ("pyannote/segmentation-3.0") — gated на HuggingFace: требует владельца
# лично зайти на HF, создать токен и принять лицензию — это `/human`-
# задача (устав §6, CLAUDE.md §5.2 — агент не может принимать
# лицензионные соглашения от лица владельца), и она блокировала бы ЛЮБОЙ
# запуск транскрипции до её выполнения. Вместо этого — Silero VAD
# (MIT, не gated, ставится ниже) для собственной сегментации длинных
# файлов на куски ≤25с (жёсткий лимит `.transcribe()` у GigaAM без
# longform, проверено по коду репозитория), сборка сегментов и таймкодов
# — в helm_core, не в GigaAM.
RUN pip install --no-cache-dir "gigaam[torch] @ git+https://github.com/salute-developers/GigaAM.git@7447938d791c4f3e643386ee22c33777004293a5"
RUN pip install --no-cache-dir "silero-vad==6.2.1"

# sqlalchemy/psycopg — БЕЗ версии pydantic/pydantic-settings рядом с
# ними: НАЙДЕНО живым тестом на сервере — если запинить pydantic ДО
# docling (как было в первой версии этого файла), pip не станет её
# апгрейдить (формально совместимо по диапазону версий), и docling
# падает на первом же файле `PydanticSerializationError: Circular
# reference detected` внутри собственного _get_pipeline() — это баг
# несовместимости версий docling-core с pydantic 2.10.4, не файла.
# pydantic/pydantic-settings обязаны прийти из зависимостей docling
# (проверено в песочнице разработки: docling тянет pydantic 2.13.5 и
# требует pydantic-settings>=2.14.0 — конфликт исчезает, когда версии
# не фиксируются вручную заранее).
RUN pip install --no-cache-dir "sqlalchemy==2.0.36" "psycopg[binary]==3.2.3" "pgvector==0.5.0"
RUN pip install --no-cache-dir -U pydantic-settings

COPY helm_core ./helm_core

# Веса выбранной модели (e2e_rnnt, ADR-021) запекаются один раз НА
# СБОРКЕ, не при каждом старте контейнера — тот же приём и та же
# причина, что у helm-embed/HF_HOME (ADR-025): без этого
# gigaam.load_model(...) качал бы веса с сети при КАЖДОМ
# force-recreate (каждый выкат), и первая живая транскрипция после
# деплоя зависела бы от доступности источника весов именно в этот
# момент, а не в момент сборки. Путь читается из
# audio.py::GIGAAM_DOWNLOAD_ROOT (не дублируется здесь строкой) —
# единственный источник истины на сборку и рантайм.
RUN GIGAAM_DIR=$(python3 -c "from helm_core.knowledge.audio import GIGAAM_DOWNLOAD_ROOT; print(GIGAAM_DOWNLOAD_ROOT)") \
    && python3 -c "from helm_core.knowledge.audio import MODEL_NAME, GIGAAM_DOWNLOAD_ROOT; \
import gigaam; gigaam.load_model(MODEL_NAME, download_root=GIGAAM_DOWNLOAD_ROOT)" \
    && chown -R helm-worker:helm-worker "$GIGAAM_DIR"

USER helm-worker

CMD ["python3", "-m", "helm_core.knowledge.worker_main"]
