# HELM Knowledge embedding service (P8.5.4 остаток, §33 — модель фиксируется
# только после замера на живом сервере, не заранее).
#
# Отдельный образ от Control Plane (768MB, без torch вовсе — см.
# Dockerfile.worker) и от воркера (Docling — другой набор моделей и
# system-библиотек, opencv/ffmpeg здесь не нужны): эмбеддингам нужен только
# CPU-only torch + sentence-transformers, отдельный процесс со своим лимитом
# памяти, который не должен конкурировать за RAM ни с живыми вебхуками
# (helm-core), ни с разбором документов (воркер).
FROM python:3.12.8-slim-bookworm AS base

RUN useradd --system --create-home --uid 10003 helm-embed

WORKDIR /opt/helm/embed

# CPU-only torch с официального индекса — тот же приём, что Dockerfile.worker
# (иначе pip тянет CUDA-сборку, ~1.2GB лишнего на сервере без GPU). Здесь без
# torchvision: он нужен Docling для OCR/layout-моделей изображений, эмбеддинги
# текста в нём не нуждаются.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir "sentence-transformers==3.3.1" \
      "fastapi==0.115.6" "uvicorn[standard]==0.34.0"

COPY helm_core ./helm_core

# Веса скачиваются один раз НА СБОРКЕ, не при каждом старте контейнера
# (§33 — веса модели такая же фиксируемая зависимость, как версия пакета).
# Без этого шага SentenceTransformer(MODEL_NAME) в embed_service.py тянул
# бы веса с huggingface.co при каждом `force-recreate` (каждый выкат) —
# лишний внешний трафик и время подъёма сервиса зависели бы от
# доступности huggingface.co именно в момент рестарта, а не сборки.
# HF_HOME фиксирован явно: сборка идёт от root (домашний каталог
# /root), а сервис в рантайме — от helm-embed (другой $HOME); без общего
# пути кэш, скачанный при сборке, был бы недоступен процессу в рантайме.
ENV HF_HOME=/opt/helm/embed/hf-cache
RUN python3 -c "from helm_core.knowledge.embed_service import MODEL_NAME; \
from sentence_transformers import SentenceTransformer; SentenceTransformer(MODEL_NAME)" \
    && chown -R helm-embed:helm-embed "$HF_HOME"

USER helm-embed
EXPOSE 8090

# Постоянный сервис (ADR-025 — модель выбрана живым замером 31.08.2026).
# embed_benchmark.py остаётся в образе для повторного замера при смене
# кандидатов в будущем — запускается через override:
#   docker compose run --rm --entrypoint python3 helm-embed \
#     -m helm_core.knowledge.embed_benchmark
CMD ["uvicorn", "helm_core.knowledge.embed_service:create_app", "--factory", \
     "--host", "0.0.0.0", "--port", "8090", "--workers", "1", \
     "--no-server-header"]
