# Публичный периметр HELM (ТЗ §4.6).
#
# Правило чтения этого файла: всё, что не перечислено явно, наружу не
# выходит. Поэтому здесь нет ни одного `reverse_proxy` без точного пути —
# любой wildcard превратил бы internal API в публичный.
#
# Не публикуются никогда: PostgreSQL, LiteLLM, Hermes API/dashboard,
# admin API Control Plane, редактор n8n, внутренняя БД SignalAI.
# Редактор n8n открывается только SSH-туннелем.

{
	admin off
	email admin@cmpas.ru
	servers {
		# Заголовок Server не сообщает версию: бесплатная разведка для
		# сканера, нулевая польза для владельца.
		trusted_proxies static private_ranges
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
}

# Cross-Origin-Opener-Policy НЕ входит в security_headers (в отличие от
# остальных) намеренно: header-директива на уровне всего сайта компилируется
# с "deferred":true (применяется последней из всей цепочки, после любых
# вложенных handle-блоков) — переопределить её изнутри handle нельзя в
# принципе, не баг, а поведение Caddy (проверено вживую через autosave.json).
# Поэтому COOP задаётся явно в каждом handle ниже — везде "same-origin",
# кроме /login, которому нужен "unsafe-none" для Telegram Login Widget.
(coop_locked) {
	header Cross-Origin-Opener-Policy "same-origin"
}

helm.cmpas.ru {
	import security_headers
	encode zstd gzip

	log {
		output file /var/log/caddy/helm.log {
			roll_size 20mb
			roll_keep 5
		}
		# Тело запроса не логируется: в /auth/* приходят passkey-assertion,
		# а в /hooks/* — полезная нагрузка вебхуков.
		format json
	}

	# ── Panel API. Только этот префикс, без вложенных wildcard ──────────────
	handle /api/panel/v1/* {
		import coop_locked
		reverse_proxy 127.0.0.1:8080
	}

	# ── Аутентификация панели (§10.5.6) ────────────────────────────────────
	handle /auth/* {
		import coop_locked
		reverse_proxy 127.0.0.1:8080
	}

	# ── Явно зарегистрированные вебхуки. Перечисляются поимённо ────────────
	handle /hooks/max {
		import coop_locked
		reverse_proxy 127.0.0.1:8080
	}

	# v3.8 P8.6.2: вебхук Dedicated Knowledge Bot. Отдельный путь, а не
	# /hooks/* — правило «перечисляются поимённо» существует ровно затем,
	# чтобы новый роутер FastAPI не оказывался снаружи автоматически.
	# Подлинность проверяет сам Control Plane по заголовку
	# X-Telegram-Bot-Api-Secret-Token (fail-closed, в том числе когда
	# секрет не задан вовсе).
	handle /hooks/knowledge-telegram {
		import coop_locked
		reverse_proxy 127.0.0.1:8080
	}

	# ── Санитизированный статус Guardian (§10.5.9, §25.5) ──────────────────
	# Отдаётся файлом, а не проксированием: он обязан работать, когда
	# Control Plane лежит — именно ради этого случая он и существует.
	# handle_path, не handle: handle не срезает совпавший префикс из URI,
	# и file_server искал бы /srv/guardian/guardian/status.json вместо
	# примонтированного /srv/guardian/status.json — 404 при исправной
	# конфигурации. Найдено на реальном P2 bring-up.
	handle_path /guardian/* {
		import coop_locked
		root * /srv/guardian
		header Cache-Control "no-store"
		header Content-Type "application/json"
		file_server
	}

	# ── Экран входа (§10.5.6): отдельный handle, не матчер внутри общего ────
	# Ему нужен свой, ослабленный COOP (Telegram Login Widget сообщает о
	# завершении входа через window.opener из всплывающего окна
	# oauth.telegram.org — same-origin эту связь рвёт) и своя, чуть более
	# широкая CSP (единственное место, где грузится сторонний
	# <script src="https://telegram.org/..."> самого виджета).
	handle /login {
		header Cross-Origin-Opener-Policy "unsafe-none"
		root * /srv/panel
		header Cache-Control "no-store"
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; frame-src https://oauth.telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://telegram.org; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		rewrite * /index.html
		file_server
	}

	# ── Статика панели (§10.5.2, §10.5.3) ──────────────────────────────────
	handle {
		import coop_locked
		root * /srv/panel
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-store"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		try_files {path} /index.html
		file_server
	}
}

git.cmpas.ru {
	import security_headers
	import coop_locked
	encode zstd gzip
	# §18.1: приватный по умолчанию — сам Forgejo (REQUIRE_SIGNIN_VIEW,
	# DISABLE_REGISTRATION в docker-compose.yml) решает, кто видит содержимое;
	# Caddy здесь только TLS-периметр домена, не дополнительный слой авторизации.
	reverse_proxy 127.0.0.1:3000 {
		health_uri /api/healthz
	}
}

# Обращение по IP или неизвестному имени не должно раскрывать, что здесь
# вообще что-то есть.
:443 {
	tls internal
	respond 404
}
