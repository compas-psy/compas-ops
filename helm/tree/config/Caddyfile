# Публичный периметр HELM (ТЗ §4.6).
#
# Правило чтения этого файла: всё, что не перечислено явно, наружу не
# выходит. Поэтому здесь нет ни одного `reverse_proxy` без точного пути —
# любой wildcard превратил бы internal API в публичный.
#
# Не публикуются никогда: PostgreSQL, LiteLLM, Hermes API/dashboard,
# admin API Control Plane, редактор n8n, внутренняя БД SignalAI.
# Редактор n8n открывается только SSH-туннелем.

{
	admin off
	email admin@cmpas.ru
	servers {
		# Заголовок Server не сообщает версию: бесплатная разведка для
		# сканера, нулевая польза для владельца.
		trusted_proxies static private_ranges
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
}

helm.cmpas.ru {
	import security_headers
	encode zstd gzip

	log {
		output file /var/log/caddy/helm.log {
			roll_size 20mb
			roll_keep 5
		}
		# Тело запроса не логируется: в /auth/* приходят passkey-assertion,
		# а в /hooks/* — полезная нагрузка вебхуков.
		format json
	}

	# ── Panel API. Только этот префикс, без вложенных wildcard ──────────────
	handle /api/panel/v1/* {
		reverse_proxy 127.0.0.1:8080
	}

	# ── Аутентификация панели (§10.5.6) ────────────────────────────────────
	handle /auth/* {
		reverse_proxy 127.0.0.1:8080
	}

	# ── Явно зарегистрированные вебхуки. Перечисляются поимённо ────────────
	handle /hooks/max {
		reverse_proxy 127.0.0.1:8080
	}

	# ── Санитизированный статус Guardian (§10.5.9, §25.5) ──────────────────
	# Отдаётся файлом, а не проксированием: он обязан работать, когда
	# Control Plane лежит — именно ради этого случая он и существует.
	# handle_path, не handle: handle не срезает совпавший префикс из URI,
	# и file_server искал бы /srv/guardian/guardian/status.json вместо
	# примонтированного /srv/guardian/status.json — 404 при исправной
	# конфигурации. Найдено на реальном P2 bring-up.
	handle_path /guardian/* {
		root * /srv/guardian
		header Cache-Control "no-store"
		header Content-Type "application/json"
		file_server
	}

	# ── Экран входа (§10.5.6): отдельный handle, не матчер внутри общего ────
	# Казалось бы, что достаточно `header /login ...` внутри общего handle{}
	# ниже — но это не сработало на живом тесте: header-директива с матчером
	# внутри handle, конфликтующая по имени поля с header'ом из security_headers
	# на уровне сайта, надёжно не переопределяет значение (известная особенность
	# Caddy на стыке header+handle, caddyserver/caddy#7598). header без матчера
	# прямо в СВОЁМ handle-блоке — переопределяет надёжно, поэтому у /login
	# отдельный блок, а не условие внутри общего.
	handle /login {
		root * /srv/panel
		header Cache-Control "no-store"
		# CSP шире, чем у остального SPA: экран входа — единственное место,
		# где нужен сторонний <script src="https://telegram.org/..."> самого
		# виджета (рисует кнопку через iframe с oauth.telegram.org).
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; frame-src https://oauth.telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://telegram.org; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		# same-origin (из security_headers) рвёт window.opener между
		# всплывающим окном oauth.telegram.org и этой страницей — виджет не
		# может сообщить родителю о завершении входа. Блочная форма (не
		# однострочная `header Field "value"`) обязательна: security_headers
		# компилируется с "deferred":true (применяется последним из всех),
		# однострочная форма — нет, поэтому её тут же перезаписывало обратно
		# на same-origin. Проверено на живом сервере через autosave.json.
		header {
			Cross-Origin-Opener-Policy "unsafe-none"
		}
		rewrite * /index.html
		file_server
	}

	# ── Статика панели (§10.5.2, §10.5.3) ──────────────────────────────────
	handle {
		root * /srv/panel
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-store"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		try_files {path} /index.html
		file_server
	}
}

git.cmpas.ru {
	import security_headers
	encode zstd gzip
	# Forgejo появляется в P6.5; до установки домен отвечает 503, а не
	# проксирует в пустоту.
	reverse_proxy 127.0.0.1:3000 {
		health_uri /api/healthz
	}
}

# Обращение по IP или неизвестному имени не должно раскрывать, что здесь
# вообще что-то есть.
:443 {
	tls internal
	respond 404
}
